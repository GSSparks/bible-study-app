generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String?
  reference     String?
  module        String?
  quote         String?
  body          String
  tags          String[]
  fromAssistant Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([reference])
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference String
  module    String
  color     String   @default("yellow")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([reference])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference String
  module    String
  label     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([reference])
}

model Document {
  id            String   @id @default(cuid())
  title         String
  author        String?
  filename      String   @unique
  pageCount     Int?
  extractedText String?
  createdAt     DateTime @default(now())
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference String?
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([reference])
}

model PersonalModule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  name      String
  createdAt DateTime @default(now())

  entries PersonalEntry[]

  @@index([userId])
}

model PersonalEntry {
  id             String         @id @default(cuid())
  moduleId       String
  personalModule PersonalModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  key            String?
  reference      String?
  title          String
  body           String
  createdAt      DateTime       @default(now())

  @@index([moduleId, key])
  @@index([moduleId, reference])
}

model User {
  id             String    @id @default(cuid())
  username       String    @unique
  passwordHash   String
  role           String    @default("user")
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?

  notes           Note[]
  highlights      Highlight[]
  bookmarks       Bookmark[]
  studySessions   StudySession[]
  personalModules PersonalModule[]
  connectionsSent     Connection[] @relation("ConnectionsSent")
  connectionsReceived Connection[] @relation("ConnectionsReceived")
  scriptoriumsOwned          Scriptorium[]           @relation("ScriptoriumsOwned")
  scriptoriumMemberships     ScriptoriumMembership[]
  scriptoriumInvitesSent     ScriptoriumInvite[]      @relation("ScriptoriumInvitesSent")
  scriptoriumInvitesReceived ScriptoriumInvite[]      @relation("ScriptoriumInvitesReceived")
  posts    Post[]
  comments Comment[]
  studiesCreated         Study[]                  @relation("StudiesCreated")
  studyParticipations    StudyParticipant[]
  studyLessonCompletions StudyLessonCompletion[]
  studyComments      StudyComment[]
  studyCommentLikes  StudyCommentLike[]
}

// Mutual-acceptance connections ("Fellows" in the UI). One row per
// pair with a status, not two directional rows — simpler to query "are
// these two connected" and can't get out of sync with itself.
// requesterId/recipientId track who sent it, but once accepted the
// relationship is symmetric — both people see each other as a Fellow.
model Connection {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("ConnectionsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("ConnectionsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending" | "accepted" | "declined"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

model AppSetting {
  key   String @id
  value String
}

model ModuleVisibility {
  moduleCode       String  @id
  availableToUsers Boolean @default(true)
}

// The core, named community unit of this app — "Scriptoriums" in the
// UI, matching the app's own branding rather than a generic "Group"
// name, since this isn't a utility feature but the central social
// concept the whole vision is built around.
model Scriptorium {
  id          String   @id @default(cuid())
  name        String
  description String?
  visibility  String   @default("private") // "private" | "public" — private: invite-only, hidden from browse for non-members; public: any logged-in user can find and join directly
  ownerId     String
  owner       User     @relation("ScriptoriumsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  memberships ScriptoriumMembership[]
  invites     ScriptoriumInvite[]
  posts       Post[]
  studies     Study[]
}

model ScriptoriumMembership {
  id            String      @id @default(cuid())
  scriptoriumId String
  scriptorium   Scriptorium @relation(fields: [scriptoriumId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String      @default("member") // "owner" | "member"
  joinedAt      DateTime    @default(now())

  @@unique([scriptoriumId, userId])
  @@index([userId])
}

// Invites route through the existing Fellows graph rather than an open
// link — you invite someone you're already connected to. Same
// mutual-request-shaped pattern as Connection (one row, a status,
// re-inviting after a decline resets the row rather than duplicating
// it), though invites here are one-directional by nature.
model ScriptoriumInvite {
  id            String      @id @default(cuid())
  scriptoriumId String
  scriptorium   Scriptorium @relation(fields: [scriptoriumId], references: [id], onDelete: Cascade)
  inviterId     String
  inviter       User        @relation("ScriptoriumInvitesSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId     String
  invitee       User        @relation("ScriptoriumInvitesReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  status        String      @default("pending") // "pending" | "accepted" | "declined"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([scriptoriumId, inviteeId])
  @@index([inviteeId, status])
}

// A single model covers both personal-wall and Scriptorium-wall posts
// — scriptoriumId null means a personal wall post, set means it's
// posted to that Scriptorium's wall.
model Post {
  id            String   @id @default(cuid())
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  scriptoriumId String?
  scriptorium   Scriptorium? @relation(fields: [scriptoriumId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime @default(now())

  comments      Comment[]

  @@index([authorId])
  @@index([scriptoriumId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

// Phase A of Studies — the core structure everything else (comments,
// AI-assisted generation, resources) builds on top of.
model Study {
  id            String       @id @default(cuid())
  title         String
  description   String?
  scriptoriumId String?      // null = personal solo study, private to the creator; set = group study, inherits that Scriptorium's own visibility/membership rules entirely
  scriptorium   Scriptorium? @relation(fields: [scriptoriumId], references: [id], onDelete: Cascade)
  creatorId     String
  creator       User         @relation("StudiesCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  lessons      StudyLesson[]
  participants StudyParticipant[]
  resources    StudyResource[]

  @@index([scriptoriumId])
  @@index([creatorId])
}

// Each "week" — a passage pointer PLUS the leader's own shared write-up
// (body). Participants' own private notes reuse the existing Note
// model entirely, filtered by this lesson's reference, rather than a
// new per-user notes table.
model StudyLesson {
  id        String   @id @default(cuid())
  studyId   String
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  module    String?
  reference String?
  body      String?
  createdAt DateTime @default(now())

  completions StudyLessonCompletion[]
  comments    StudyComment[]

  @@index([studyId])
}

model StudyParticipant {
  id       String   @id @default(cuid())
  studyId  String
  study    Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("participant") // "owner" | "participant"
  joinedAt DateTime @default(now())

  @@unique([studyId, userId])
  @@index([userId])
}

model StudyLessonCompletion {
  id          String      @id @default(cuid())
  lessonId    String
  lesson      StudyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime    @default(now())

  @@unique([lessonId, userId])
  @@index([userId])
}

// Phase B — the "Discussion" tab. Scoped to a lesson (not the whole
// Study). Viewing a lesson's comments only requires being able to view
// the lesson itself; posting a comment or a like requires actually
// being a participant.
model StudyComment {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    StudyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  likes StudyCommentLike[]

  @@index([lessonId])
}

model StudyCommentLike {
  id        String       @id @default(cuid())
  commentId String
  comment   StudyComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([commentId, userId])
  @@index([userId])
}

// Phase D — the leader-curated resource list behind the footer.
// "commentary" resources point at an installed SWORD module (fetched
// against whichever lesson's reference is currently open); "link"
// resources point at an external URL the frontend just opens. The
// always-present "Text" compare-translations tab isn't stored here at
// all — it's built into the footer itself, reusing the existing
// compare-translations endpoint directly, not a per-study resource a
// leader curates.
model StudyResource {
  id         String   @id @default(cuid())
  studyId    String
  study      Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  type       String   // "commentary" | "link"
  label      String   // footer tab display text, e.g. "Commentary: Clarke" or "Bible Project: John"
  moduleCode String?  // required for type="commentary"
  url        String?  // required for type="link"
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([studyId])
}
