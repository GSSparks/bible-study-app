generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A note can be anchored to a passage (reference + module set) or
// freestanding (a personal study note, journal entry, etc. — reference
// and module left null). It can also carry a `quote`: the exact text the
// person selected when creating it, distinct from `body` (their own
// commentary on that quote). Both kinds are searchable and both can be
// pulled into the study assistant's context.
model Note {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  reference  String?
  module     String? // which SWORD module the note is anchored to, e.g. "KJV"
  quote      String? // the exact selected text this note is annotating, if any
  body       String
  tags       String[] @default([])
  fromAssistant Boolean @default(false) // saved from a study assistant reply
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([reference])
  @@index([userId])
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference String
  module    String
  color     String   @default("yellow")
  createdAt DateTime @default(now())

  @@index([reference])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference String
  module    String
  label     String?
  createdAt DateTime @default(now())

  @@index([reference])
  @@index([userId])
}

// Metadata for uploaded PDFs (commentaries, study guides, etc.)
// The actual file lives on disk under the pdf storage volume.
model Document {
  id          String   @id @default(cuid())
  title       String
  author      String?
  filename    String   @unique
  pageCount   Int?
  extractedText String? // used for full-text search alongside SWORD content
  createdAt   DateTime @default(now())
}

// A saved LLM study conversation. Historically scoped to one
// reference/module; now a conversation's context can span several open
// windows at once, so those are optional and the full source list lives
// in contextSnapshot.
model StudySession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference     String?
  module        String?
  messages      Json // [{ role, content, ts }]
  contextSnapshot Json? // the assembled context sent to the LLM at session start
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// A personal, AI-study-derived "module" — DICT-type (word studies,
// entries keyed by term) or COMMENTARY-type (conversations about a
// passage, entries keyed by reference). Listed alongside real SWORD
// modules under a "personal:<id>" module code, so the app's existing
// dictionary/commentary browsing UI works on these without any changes —
// see backend/src/services/personalModuleService.js.
//
// Private per-user: each user gets their own separate "My Word
// Studies"/"My Studies" module rather than one everyone shares —
// confirmed explicitly, not assumed. getOrCreateDefaultPersonalModule
// looks up/creates scoped to (type, name, userId), not just (type,
// name), so two different users' "My Word Studies" are two entirely
// separate rows even though they share a display name.
model PersonalModule {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'DICT' | 'COMMENTARY'
  name      String // display name, e.g. "My Word Studies"
  createdAt DateTime        @default(now())
  entries   PersonalEntry[]

  @@index([userId])
}

model PersonalEntry {
  id         String         @id @default(cuid())
  moduleId   String
  module     PersonalModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  key        String? // DICT-type: the term/word (e.g. "G26")
  reference  String? // COMMENTARY-type: the reference this entry is about (e.g. "John 3:16-18")
  title      String
  body       String // HTML — converted from the LLM's markdown reply at save time
  createdAt  DateTime       @default(now())

  @@index([moduleId, key])
  @@index([moduleId, reference])
}

// Auth. Deliberately minimal for Phase 1 — just enough for login,
// roles, and the bootstrap-safety mechanism. Per-user data ownership
// (adding userId to Note/Highlight/PersonalModule/etc.) is Phase 2,
// not part of this migration.
model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         String    @default("user") // "admin" | "user"
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  notes           Note[]
  highlights      Highlight[]
  bookmarks       Bookmark[]
  studySessions   StudySession[]
  personalModules PersonalModule[]
  connectionsSent     Connection[] @relation("ConnectionsSent")
  connectionsReceived Connection[] @relation("ConnectionsReceived")
}

// Mutual-acceptance connections ("Fellows" in the UI). One row per
// pair with a status, not two directional rows — simpler to query "are
// these two connected" and can't get out of sync with itself.
// requesterId/recipientId track who sent it, but once accepted the
// relationship is symmetric — both people see each other as a Fellow.
//
// The @@unique constraint only prevents a duplicate in the SAME
// direction (A requesting B twice) — it does not prevent A requesting
// B while B is separately, simultaneously requesting A. That's handled
// in application logic (connectionService.sendRequest), not the
// schema: a new request first checks for a reverse-direction pending
// row and auto-accepts both as one connection instead of creating a
// duplicate.
model Connection {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("ConnectionsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("ConnectionsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending" | "accepted" | "declined"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@index([requesterId, status])
}

// A generic key/value settings table. Right now it exists for exactly
// one purpose: bootstrapAdmin() inserts a row here under a fixed unique
// key inside the same transaction that creates the first admin, so
// Postgres's own unique-constraint enforcement — atomic even under
// concurrent transactions — is what guarantees only one "first admin"
// can ever be created, rather than relying on a check-then-create
// pattern that would leave a real race window open. See
// authService.js's bootstrapAdmin for the full reasoning.
model AppSetting {
  key   String @id
  value String
}

// NOTE: this migration's SQL also creates a `session` table, but it is
// deliberately NOT represented as a Prisma model here. connect-pg-simple
// (the session store) reads and writes that table directly via its own
// raw SQL — Prisma Client is never used to query it — so modeling it
// here would just create a model nothing ever calls, while the actual
// schema is defined by connect-pg-simple's own conventions instead of
// Prisma's.
// Tracks which installed modules are exposed to non-admin users.
// Separate from "is it installed" (that's SWORD's own state, or
// PersonalModule for personal ones) — an admin can install something
// and deliberately not make it available yet. Defaults to available:
// installing something today already makes it usable immediately, and
// this is additive on top of that existing behavior rather than a
// reversal of it — nothing becomes newly hidden just because this
// table now exists. No row for a module means "available" (the
// default); a row only needs to exist once something is deliberately
// hidden.
model ModuleVisibility {
  moduleCode       String  @id
  availableToUsers Boolean @default(true)
}
