# Copy this to .env and fill in real values before running docker compose up

POSTGRES_PASSWORD=change_me

# Optional: enables the LLM study assistant. Leave blank to run without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: directory for Markdown-based modules (commentaries, dictionaries, Bible texts).
# Default: /data/md-modules
# MD_MODULES_PATH=/data/md-modules
